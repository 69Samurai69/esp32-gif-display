# Normaliza fim de linha: LF no repositório, nativo no working tree.
* text=auto

# Arquivos sempre LF
*.cpp   text eol=lf
*.h     text eol=lf
*.ino   text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.csv   text eol=lf
*.ini   text eol=lf

# Scripts Windows com CRLF
*.bat   text eol=crlf

# Binários (sem conversão)
*.gif   binary
*.bin   binary
*.zip   binary
